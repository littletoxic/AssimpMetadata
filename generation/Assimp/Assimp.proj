<Project Sdk="Microsoft.Windows.WinmdGenerator/0.70.11-preview">
  <PropertyGroup>
    <OutputWinmd>$(MSBuildThisFileDirectory)..\..\bin\Assimp.winmd</OutputWinmd>
    <WinmdVersion>$(AssimpWinmdVersion)</WinmdVersion>
    <AdditionalIncludes>include</AdditionalIncludes>
    <SdkIncRoot>include</SdkIncRoot>
  </PropertyGroup>

  <ItemGroup>
    <Partition Include="main.cpp">
      <ExcludeFromCrossarch>true</ExcludeFromCrossarch>
    </Partition>
  </ItemGroup>

  <ItemGroup>
    <ScraperRsp Include="common.settings.rsp" />
  </ItemGroup>

</Project>
